# Environment Variables for Sepolia Deployment
# Get your Infura API key from: https://infura.io/
INFURA_API_KEY=your_infura_api_key_here

# Your wallet private key (NEVER share this publicly!)
# Make sure to add funds to this wallet on Sepolia testnet
PRIVATE_KEY=your_private_key_here

# Get your Etherscan API key from: https://etherscan.io/apis
# Used for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here