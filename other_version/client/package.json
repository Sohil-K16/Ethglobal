{
  "name": "decentralfund-client",
  "description": "DecentralFund - Web3 Crowdfunding Platform Frontend",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "web3",
    "blockchain",
    "crowdfunding",
    "react",
    "ethereum"
  ],
  "author": "DecentralFund Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && npx thirdweb@latest upload dist",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "start": "npm run dev"
  },
  "dependencies": {
    "@thirdweb-dev/react": "^3",
    "@thirdweb-dev/sdk": "^3",
    "ethers": "^5.7.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.4.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^2",
    "autoprefixer": "^10.4.13",
    "postcss": "^8.4.19",
    "tailwindcss": "^3.2.4",
    "vite": "^3"
  }
}
