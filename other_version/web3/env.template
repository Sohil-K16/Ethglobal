# Environment Configuration Template for DecentralFund

# =============================================================================
# REQUIRED CONFIGURATIONS
# =============================================================================

# Your wallet private key (NEVER share this publicly)
# Get this from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_wallet_private_key_here

# thirdweb API Key for deployment and Web3 services  
# Get this from: https://thirdweb.com/dashboard
THIRDWEB_API_KEY=your_thirdweb_api_key_here

# =============================================================================
# OPTIONAL CONFIGURATIONS (for advanced features)
# =============================================================================

# Infura Project ID (for enhanced RPC endpoints)
# Get this from: https://infura.io/dashboard
# INFURA_API_KEY=your_infura_project_id

# Etherscan API Key (for contract verification)
# Get this from: https://etherscan.io/apis
# ETHERSCAN_API_KEY=your_etherscan_api_key

# Alchemy API Key (alternative to Infura)
# Get this from: https://dashboard.alchemy.com/
# ALCHEMY_API_KEY=your_alchemy_api_key

# =============================================================================
# NETWORK CONFIGURATIONS
# =============================================================================

# Default network for deployment (goerli, mumbai, mainnet, polygon)
NETWORK=goerli

# Custom RPC URLs (optional)
# GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY
# MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_INFURA_KEY

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. NEVER commit this file to version control
# 2. Use testnet for development (goerli, mumbai)
# 3. Use separate wallets for development and production
# 4. Keep your private keys secure and never share them
# 5. Consider using hardware wallets for mainnet deployments

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file and rename it to '.env' in the web3 directory
# 2. Fill in your actual values
# 3. Save the file
# 4. Run: npm run deploy

# For testnet development:
# - Get testnet ETH from faucets:
#   - Goerli: https://faucets.chain.link/goerli
#   - Mumbai: https://faucet.polygon.technology/

# For production deployment:
# - Ensure you have sufficient ETH for gas fees
# - Double-check all configurations
# - Consider using a multisig wallet